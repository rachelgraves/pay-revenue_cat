#!/usr/bin/env sh
# Wrapper for running commands with mise/asdf-managed tool versions.
# Useful in headless environments (e.g. Conductor) where version
# managers aren't activated via shell init.

# --- Try mise first ---
MISE=""
if command -v mise >/dev/null 2>&1; then
  MISE="mise"
elif [ -x "/opt/homebrew/bin/mise" ]; then
  MISE="/opt/homebrew/bin/mise"
elif [ -x "$HOME/.local/bin/mise" ]; then
  MISE="$HOME/.local/bin/mise"
elif [ -x "/usr/local/bin/mise" ]; then
  MISE="/usr/local/bin/mise"
fi

if [ -n "$MISE" ]; then
  eval "$("$MISE" env)" 2>/dev/null
  MISE_SHIMS="$HOME/.local/share/mise/shims"
  if [ -d "$MISE_SHIMS" ]; then
    export PATH="$MISE_SHIMS:$PATH"
  fi
  exec "$@"
fi

# --- Try asdf ---
ASDF_SH=""
if [ -f "$HOME/.asdf/asdf.sh" ]; then
  ASDF_SH="$HOME/.asdf/asdf.sh"
elif [ -f "/opt/homebrew/opt/asdf/libexec/asdf.sh" ]; then
  ASDF_SH="/opt/homebrew/opt/asdf/libexec/asdf.sh"
elif [ -f "/usr/local/opt/asdf/libexec/asdf.sh" ]; then
  ASDF_SH="/usr/local/opt/asdf/libexec/asdf.sh"
fi

if [ -n "$ASDF_SH" ]; then
  . "$ASDF_SH"
  exec "$@"
fi

# --- Fallback: run directly ---
exec "$@"
